# ═══════════════════════════════════════════════════════════════════
#  PLANTILLA DE VARIABLES DE ENTORNO
#  Copia este archivo como .env y rellena con tus datos reales.
# ═══════════════════════════════════════════════════════════════════

# ─── Telegram Bot ───
API_ID=12345678
API_HASH=tu_api_hash_aqui
BOT_TOKEN=tu_bot_token_aqui

# ─── Admins (IDs separados por coma) ───
ADMIN_IDS=123456789,987654321

# ─── MongoDB ───
# Opción A: MongoDB Atlas (nube)
MONGO_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Opción B: MongoDB local (si descomentaste el servicio en docker-compose)
# MONGO_URI=mongodb://botuser:tu_password_seguro@mongo:27017/bot_descargas?authSource=admin

# ─── Redes Sociales (opcional, para cuentas de IG/TikTok) ───
SOCIAL_USERNAME=
SOCIAL_PASSWORD=

# ─── MEGA (opcional, mejora la velocidad de MEGA) ───
MEGA_EMAIL=
MEGA_PASSWORD=

# ─── Spotify (opcional) ───
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Cookies de YouTube (opcional, en base64) ───
YOUTUBE_COOKIES_B64=
